#!/bin/sh
#
# Refuses to push unless a clean production build succeeds.
# This is the same failure Vercel would report, caught locally instead.

set -e

echo "pre-push: running production build..."

if ! npm run build; then
  echo ""
  echo "pre-push: BUILD FAILED - nothing was pushed."
  echo "If the error is 'Could not resolve ./something', you created a file"
  echo "that an import depends on but never staged it. Run:"
  echo "    git status --short"
  echo "then 'git add -A' and commit the missing files."
  echo ""
  exit 1
fi

echo "pre-push: build ok, checking for untracked files..."

UNTRACKED=$(git ls-files --others --exclude-standard -- src public index.html)
if [ -n "$UNTRACKED" ]; then
  echo ""
  echo "pre-push: untracked files under src/ or public/ that are NOT committed:"
  echo "$UNTRACKED"
  echo ""
  echo "If any of these are imported by tracked code, the push will build"
  echo "fine locally but fail on Vercel. Stage them with 'git add -A'."
  echo ""
  exit 1
fi

echo "pre-push: ok"
